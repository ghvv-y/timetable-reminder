@echo off
chcp 65001 >nul
setlocal

REM ============================================================
REM  课表识别 —— 一键把教务系统导出的课表图片转成 App 可导入的文件
REM
REM  用法：把课表图片设成参数，或者直接双击按提示输入
REM ============================================================

set "TOOL=%~dp0recognize_schedule.py"
set "IMG=%~1"

if "%IMG%"=="" (
    echo.
    echo   请把课表图片拖到本文件上，或直接把路径粘贴到下面。
    echo.
    set /p IMG=图片路径：
)

if "%IMG%"=="" (
    echo   没有提供图片路径，退出。
    pause
    exit /b 1
)

REM 去掉可能带的引号
set IMG=%IMG:"=%

echo.
echo ============================================================
echo   开始识别
echo ============================================================
echo   图片：%IMG%
echo.

python "%TOOL%" "%IMG%"

echo.
echo ============================================================
echo   完成。生成的「课表导入.json」在图片所在目录。
echo   把它传到手机，在 App 的课表页点右上角 ⬇ 导入即可。
echo ============================================================
echo.
pause
