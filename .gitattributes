# 统一按 UTF-8 处理，避免 Windows 上 GBK 误判导致中文注释乱码
* text=auto eol=lf

*.dart      text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.xml       text eol=lf

# Windows 脚本必须保留 CRLF，否则 PowerShell/CMD 可能报错
*.ps1       text eol=crlf
*.bat       text eol=crlf

# 二进制文件不做换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.apk       binary
*.jks       binary
*.keystore  binary
